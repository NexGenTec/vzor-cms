rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permitir lectura y escritura para imágenes de blog
    match /blog/{blogId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Permitir lectura pública de imágenes (para mostrar en el sitio)
    match /blog/{blogId}/main/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /blog/{blogId}/sections/{sectionPath}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Regla general para otros archivos (requiere autenticación)
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
